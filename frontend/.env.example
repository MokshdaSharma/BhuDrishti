# =============================================================================
# ParcelAI — frontend environment (copy to frontend/.env and fill in secrets)
# NEVER commit frontend/.env to git
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# Map provider:
#   auto     = use Mapbox GL JS if VITE_MAPBOX_TOKEN is set, else MapLibre GL JS
#   mapbox   = always use Mapbox GL JS (requires token)
#   maplibre = always use MapLibre GL JS (no token needed)
VITE_MAP_PROVIDER=auto

# Mapbox public token (starts with pk.)
# Leave blank to use the free MapLibre fallback — the app works fully without this.
# Get yours at https://account.mapbox.com/access-tokens/
# IMPORTANT: use a PUBLIC token only (pk.*). Never put a secret (sk.*) token here.
VITE_MAPBOX_TOKEN=
