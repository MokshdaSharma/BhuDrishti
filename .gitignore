# ==============================================================================
# ParcelAI (.gitignore)
# Never commit secrets, virtual environments, caches, or large data files
# ==============================================================================

# ── Environment & Secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
secrets/
*.pem
*.key
*.token
*.pfx

# ── Python & Virtual Environments ─────────────────────────────────────────────
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
develop-eggs/
eggs/
parts/
var/
sdist/
wheels/
share/python-wheels/

# ── Testing, Quality & Caches ──────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.cache

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Large Geospatial & ML Datasets / Weights ──────────────────────────────────
data/sample/*.tif
data/sample/*.tiff
data/sample/*.cog
data/sample/*.gpkg
data/sample/*.shp
data/sample/*.shx
data/sample/*.dbf
data/sample/*.prj
data/sample/*.cpg
data/sample/*.zip
!data/sample/.gitkeep

backend/models_store/*.pt
backend/models_store/*.pth
backend/models_store/*.onnx
backend/models_store/*.bin
!backend/models_store/.gitkeep

# Ignore dataset data files in ml/datasets but keep source code and configs
ml/datasets/*.tif
ml/datasets/*.tiff
ml/datasets/*.png
ml/datasets/*.jpg
ml/datasets/*.jpeg
ml/datasets/*.zip
ml/datasets/*.tar.gz
ml/datasets/*.geojson
ml/datasets/*_dataset/
!ml/datasets/.gitkeep
!ml/datasets/*.py
!ml/configs/.gitkeep
!ml/configs/*.yaml
!ml/configs/*.yml

# Temporary rasters / vector exports
*.cog
*.geotiff

# ── Logs & Temporary Files ────────────────────────────────────────────────────
*.log
logs/
temp/
tmp/

# ── OS & IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── Prompts / Notes (Private) ─────────────────────────────────────────────────
PROMPTS.md