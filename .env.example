# =============================================================================
# ParcelAI — backend environment (copy to .env and fill in secrets)
# NEVER commit .env to git
# =============================================================================

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=parcel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=parcelai
DATABASE_URL=postgresql+psycopg://parcel:change_me@postgis:5432/parcelai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Processing ---
DEFAULT_CRS=EPSG:32643
DATA_DIR=/data
MODEL_PATH=/models/parcelai_v1.pt
# Set MOCK_MODEL=true to run classical-CV fallback without trained weights (CPU, no GPU needed)
MOCK_MODEL=true

# --- Tile servers (internal Docker network addresses) ---
TITILER_URL=http://titiler:8000
MARTIN_URL=http://martin:3000

# --- API ---
CORS_ORIGINS=http://localhost:5173

# --- Google Earth Engine (optional — set ENABLE_GEE=false to skip entirely) ---
ENABLE_GEE=false
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
# Mount the service-account JSON key as a Docker secret at this path
GEE_KEY_FILE=/run/secrets/gee-key.json
# Precision of bounding-box coordinates sent to GEE (reduces location fingerprinting)
GEE_BBOX_PRECISION=3

# --- WebODM import (optional) ---
WEBODM_URL=
WEBODM_TOKEN=

# ─── Mapbox (optional — leave blank for free MapLibre fallback) ──────────────
# Get your free public token (pk.*) at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=


